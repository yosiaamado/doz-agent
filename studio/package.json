{
  "name": "doz-studio",
  "private": true,
  "version": "2.0.0",
  "description": "Visual editor and local runner for doz-agent workflows (plugins/workflows/*.md)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build web",
    "start": "node server/index.js",
    "test": "node --test",
    "i18n:check": "node scripts/i18n-check.js",
    "ui:smoke": "node scripts/ui-smoke.js",
    "keygen": "node scripts/keygen.js",
    "build:web": "vite build web",
    "icons": "node scripts/make-icons.js",
    "dist:win": "npm run build:web && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "fflate": "^0.8.3",
    "ws": "^8.18.0",
    "yaml": "^2.8.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.0",
    "@xyflow/react": "^12.8.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "jsdom": "^30.1.1",
    "lucide-react": "^1.48.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^8.0.0"
  },
  "main": "electron/main.js",
  "author": "Yosia Amado",
  "build": {
    "appId": "com.yosiaamado.dozstudio",
    "productName": "Doz Studio",
    "asar": true,
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "web/dist",
        "to": "web/dist"
      },
      {
        "from": "../plugins",
        "to": "plugins",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Doz-Studio-Setup-${version}-${arch}.${ext}",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Doz-Studio-${version}-${arch}.${ext}"
    }
  }
}
